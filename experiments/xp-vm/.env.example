# OpenAI-compatible gateway for the model that plays. Include the /v1 suffix: without it the
# endpoint 404s, and a client that swallows the status looks like a model answering badly.
MODEL_BASE_URL=https://gateway.example/v1
MODEL_API_KEY=
MODEL_NAME=

# The machine running QEMU, and the directory there holding disk images and monitor sockets.
# Use an ssh key. Do not put a password here.
VM_HOST=user@192.0.2.10
VM_DIR=$HOME/ra2vm
